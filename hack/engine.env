# Assigned, not defaulted: hack/engine.sh passes this name to docker rm.
ruby_sdk_engine=dagger-engine.ruby-sdk
# Defaulted: DAGGER_ENGINE and RUBY_SDK_CLI point the scripts at another engine
# and its CLI, a custom build say.
DAGGER_ENGINE=${DAGGER_ENGINE:-container://$ruby_sdk_engine}
DAGGER_LEAVE_OLD_ENGINE=1
# The CLI uploads traces to Dagger Cloud whenever it finds a login, and has no
# switch to stop that: an empty config root hides the login from test runs.
XDG_CONFIG_HOME=$HOME/.cache/ruby-sdk/config
DO_NOT_TRACK=1
DAGGER_NO_NAG=1
export DAGGER_ENGINE DAGGER_LEAVE_OLD_ENGINE XDG_CONFIG_HOME DO_NOT_TRACK DAGGER_NO_NAG

# A script finds the repository by its own path; a shell that sources this
# file finds it by its working directory.
ruby_sdk_hack=$(dirname "$0")
[ -f "$ruby_sdk_hack/engine.env" ] || ruby_sdk_hack=$(git rev-parse --show-toplevel)/hack
ruby_sdk_repo=$(cd "$ruby_sdk_hack/.." && pwd)
# A path: the scripts mount the CLI into containers.
ruby_sdk_cli=${RUBY_SDK_CLI:-$(command -v dagger || echo dagger)}
ruby_sdk_excludes='.git,**/vendor/bundle,**/.bundle'
# The SDK module's own files: what its include names, its negations aside.
ruby_sdk_module_files() {
  sed -n '/^include = \[/,/^\]/s/^ *"\([^"!][^"]*\)",\{0,1\}$/\1/p' "$ruby_sdk_repo/dagger-module.toml"
}
